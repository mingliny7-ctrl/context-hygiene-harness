{
  "manifest_version": 3,
  "name": "Desktop Pet ChatGPT Bridge",
  "version": "1.0.5",
  "description": "Local-first ChatGPT conversation capture and Atlas service access.",
  "permissions": ["storage", "tabs", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1:18000/*", "http://127.0.0.1:4173/*"],
  "background": {
    "service_worker": "bridge_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["reading_capture.js", "conversation_reader.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Conversation Collector",
    "default_popup": "popup.html"
  }
}
